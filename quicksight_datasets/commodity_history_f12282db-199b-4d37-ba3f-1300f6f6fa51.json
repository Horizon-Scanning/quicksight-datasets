        "CustomSql": {
          "DataSourceArn": "arn:aws:quicksight:eu-central-1:046214330769:datasource/c91b000b-68e6-44a2-a84e-1c1862ce88d4",
          "Name": "New custom SQL",
          "SqlQuery": "-- Union EIA spot prices with TE commodity history\r\n-- Format: te_commodity_history structure (symbol, date, open, high, low, close, commodity)\r\n\r\nSELECT \r\n    product as symbol,\r\n    DATE_PARSE(CONCAT('01/', SUBSTRING(period, 6, 2), '/', SUBSTRING(period, 1, 4)), '%d/%m/%Y') as date,\r\n    value as open,\r\n    value as high, \r\n    value as low,\r\n    value as close,\r\n    product_name as commodity\r\nFROM shippingbi.eia_spt_spot_prices_history\r\nWHERE duoarea = 'RGC'\r\n\r\nUNION ALL\r\n\r\nSELECT \r\n    symbol,\r\n    DATE_PARSE(date, '%d/%m/%Y') as date,\r\n    open,\r\n    high,\r\n    low,\r\n    close,\r\n    commodity\r\nFROM shippingbi.te_commodity_history\r\n\r\nORDER BY date DESC, symbol",
          "Columns": [
