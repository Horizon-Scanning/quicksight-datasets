          "Name": "New custom SQL",
          "SqlQuery": "SELECT\r\n    -- Correct format for \"2025-08-18\" is '%Y-%m-%d'\r\n    CAST(date_parse(forecast_extracted, '%Y-%m-%d') AS DATE) AS forecast_extracted, \r\n    CASE\r\n        WHEN LOWER(REPLACE(commodities, '-', ' ')) = 'lpg' THEN 'LPG'\r\n        ELSE ARRAY_JOIN(\r\n            TRANSFORM(\r\n                SPLIT(REPLACE(commodities, '-', ' '), ' '),\r\n                word -> UPPER(SUBSTRING(word, 1, 1)) || LOWER(SUBSTRING(word, 2))\r\n            ),\r\n            ' '\r\n        )\r\n    END AS Commodity,\r\n    reason_type,\r\n    reasons AS summaries,\r\n    countries\r\nFROM\r\n    shippingbi.te_digital_summary",
