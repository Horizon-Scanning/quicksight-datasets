    "PhysicalTableMap": {
      "6e9d64bd-f664-4544-a169-28c815d1e7bd": {
        "CustomSql": {
          "DataSourceArn": "arn:aws:quicksight:eu-central-1:046214330769:datasource/63bb5074-e9cc-4b4a-a6e5-6a304d1c2dd6",
          "Name": "New custom SQL",
          "SqlQuery": "SELECT\r\n    CAST(try(date_parse(trim(date), '%d/%m/%Y')) AS DATE) AS forecast_extracted,\r\n    CASE\r\n        WHEN LOWER(REPLACE(\"id\", '-', ' ')) = 'lpg' THEN 'LPG'\r\n        WHEN LOWER(REPLACE(\"id\", '-', ' ')) = 'crb' THEN 'CRB Index'\r\n        WHEN LOWER(REPLACE(\"id\", '-', ' ')) = 'rapeseed oil' THEN 'Rapeseed'\r\n        WHEN LOWER(REPLACE(\"id\", '-', ' ')) = 'brent crude oil' THEN 'Brent'\r\n        ELSE ARRAY_JOIN(\r\n            TRANSFORM(\r\n                SPLIT(REPLACE(\"id\", '-', ' '), ' '),\r\n                word -> UPPER(SUBSTRING(word, 1, 1)) || LOWER(SUBSTRING(word, 2))\r\n            ),\r\n            ' '\r\n        )\r\n    END AS Commodity,\r\n    reason_type,\r\n    opinion AS summaries,\r\n    countries AS countries\r\nFROM shippingbi.all_news_overviews_today_llm\r\nWHERE\r\n    opinion IS NOT NULL\r\n    AND date IS NOT NULL\r\n    AND regexp_like(trim(date), '^\\d{2}/\\d{2}/\\d{4}$')",
          "Columns": [
            {
              "Name": "forecast_extracted",
              "Type": "DATETIME"
            },
            {
              "Name": "Commodity",
              "Type": "STRING"
            },
