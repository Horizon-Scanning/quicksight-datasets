          "Name": "New custom SQL",
          "SqlQuery": "-- Union query to combine baid_history, bcti_history, and te_index_history\r\n-- Properly alias all columns to avoid schema conflicts\r\n\r\nSELECT \r\n    CAST('BAID' AS VARCHAR) as symbol,\r\n    DATE_PARSE(date, '%d/%m/%Y') as date,\r\n    CAST(NULL AS DOUBLE) as open,\r\n    CAST(price AS DOUBLE) as high,\r\n    CAST(price AS DOUBLE) as low,\r\n    CAST(price AS DOUBLE) as close,\r\n    CAST('Baltic Dirty Tanker' AS VARCHAR) as commodity\r\nFROM shippingbi.baid_history\r\n\r\nUNION ALL\r\n\r\nSELECT \r\n    CAST('BCTI' AS VARCHAR) as symbol,\r\n    DATE_PARSE(date, '%d/%m/%Y') as date,\r\n    CAST(NULL AS DOUBLE) as open,\r\n    CAST(price AS DOUBLE) as high,\r\n    CAST(price AS DOUBLE) as low,\r\n    CAST(price AS DOUBLE) as close,\r\n    CAST('Baltic Clean Tanker' AS VARCHAR) as commodity\r\nFROM shippingbi.bcti_history\r\n\r\nUNION ALL\r\n\r\nSELECT \r\n    CAST(symbol AS VARCHAR) as symbol,\r\n    DATE_PARSE(date, '%d/%m/%Y') as date,\r\n    CAST(REPLACE(CAST(open AS VARCHAR), ',', '') AS DOUBLE) as open,\r\n    CAST(REPLACE(CAST(high AS VARCHAR), ',', '') AS DOUBLE) as high,\r\n    CAST(REPLACE(CAST(low AS VARCHAR), ',', '') AS DOUBLE) as low,\r\n    CAST(REPLACE(CAST(close AS VARCHAR), ',', '') AS DOUBLE) as close,\r\n    CAST(commodity AS VARCHAR) as commodity\r\nFROM shippingbi.te_index_history\r\n\r\nORDER BY date DESC, symbol",
