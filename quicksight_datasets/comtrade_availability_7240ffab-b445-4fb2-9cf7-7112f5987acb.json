          "Name": "New custom SQL",
          "SqlQuery": "SELECT\r\n    t.*,\r\n    -- Assuming period like 202506 (YYYYMM)\r\n    date_parse(CAST(period AS varchar) || '01', '%Y%m%d')       AS period_date,\r\n    -- Assuming prev_periods same pattern\r\n    date_parse(CAST(prev_periods AS varchar) || '01', '%Y%m%d') AS prev_periods_date,\r\n    -- Robust parse for lastreleased (handles ISO, d/m/Y, Y-m-d)\r\n    CAST(\r\n        COALESCE(\r\n            TRY(from_iso8601_timestamp(lastreleased)),\r\n            TRY(date_parse(lastreleased, '%d/%m/%Y')),\r\n            TRY(date_parse(lastreleased, '%Y-%m-%d'))\r\n        ) AS timestamp\r\n    )                                                           AS lastreleased_ts\r\nFROM shippingbi.cmt_availability_history AS t",
